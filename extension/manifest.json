{
  "manifest_version": 3,
  "name": "PageForge",
  "description": "Собственные стили и разметка сайтов. Импорт и выгрузка оформлений в ZIP.",
  "version": "0.2.0",
  "permissions": ["activeTab", "storage", "scripting", "downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_title": "PageForge",
    "default_popup": "index.html"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; connect-src 'self' https://api.github.com https://codeload.github.com;"
  }
}

